local ESPSection = UITab4:section("ESP Settings", true)

-- Table de configuration globale
_G.ESPSettings = {
    Enabled = false,
    Boxes = false,
    Names = false,
    Health = false,
    Color = Color3.fromRGB(0, 255, 120)
}

local function CreateESP(Player)
    -- Initialisation des objets de dessin
    local Box = Drawing.new("Square")
    local Name = Drawing.new("Text")
    local HealthBar = Drawing.new("Line")
    local HealthBarOutline = Drawing.new("Line")

    local function HideAll()
        Box.Visible = false
        Name.Visible = false
        HealthBar.Visible = false
        HealthBarOutline.Visible = false
    end

    local connection
    connection = RunService.RenderStepped:Connect(function()
        -- 1. Vérification si le joueur et l'ESP global sont valides
        if _G.ESPSettings.Enabled and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") and Player.Character:FindFirstChild("Humanoid") then
            
            local RootPart = Player.Character.HumanoidRootPart
            local Hum = Player.Character.Humanoid
            local Pos, OnScreen = Camera:WorldToViewportPoint(RootPart.Position)

            -- 2. On n'affiche que si le joueur est sur l'écran et en vie
            if OnScreen and Hum.Health > 0 then
                local SizeY = (Camera:WorldToViewportPoint(RootPart.Position - Vector3.new(0, 3, 0)).Y - Camera:WorldToViewportPoint(RootPart.Position + Vector3.new(0, 2.8, 0)).Y)
                local SizeX = SizeY / 1.5
                local BoxPos = Vector2.new(Pos.X - SizeX / 2, Pos.Y - SizeY / 2)

                -- Boîte
                if _G.ESPSettings.Boxes then
                    Box.Visible = true
                    Box.Size = Vector2.new(SizeX, SizeY)
                    Box.Position = BoxPos
                    Box.Color = _G.ESPSettings.Color
                    Box.Thickness = 1
                else Box.Visible = false end

                -- Texte (Nom + Distance)
                if _G.ESPSettings.Names then
                    local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - RootPart.Position).Magnitude)
                    Name.Visible = true
                    Name.Text = Player.Name .. " [" .. dist .. "m]"
                    Name.Position = Vector2.new(Pos.X, BoxPos.Y - 20)
                    Name.Center = true
                    Name.Outline = true
                    Name.Size = 14
                else Name.Visible = false end

                -- Santé
                if _G.ESPSettings.Health then
                    local HealthPercent = Hum.Health / Hum.MaxHealth
                    HealthBarOutline.Visible = true
                    HealthBarOutline.From = Vector2.new(BoxPos.X - 5, BoxPos.Y + SizeY)
                    HealthBarOutline.To = Vector2.new(BoxPos.X - 5, BoxPos.Y)
                    
                    HealthBar.Visible = true
                    HealthBar.From = Vector2.new(BoxPos.X - 5, BoxPos.Y + SizeY)
                    HealthBar.To = Vector2.new(BoxPos.X - 5, BoxPos.Y + SizeY - (SizeY * HealthPercent))
                    HealthBar.Color = Color3.fromHSV(HealthPercent * 0.3, 1, 1) -- Vert à Rouge
                else
                    HealthBar.Visible = false
                    HealthBarOutline.Visible = false
                end
            else
                HideAll()
            end
        else
            HideAll()
            -- Si le joueur quitte le serveur
            if not Player.Parent then
                Box:Remove()
                Name:Remove()
                HealthBar:Remove()
                HealthBarOutline:Remove()
                connection:Disconnect()
            end
        end
    end)
end

